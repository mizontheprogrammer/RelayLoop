<Window x:Class="RelayLoop.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelayLoop Runner"
        Width="476"
        Height="414"
        MinWidth="440"
        MinHeight="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="RelayLoop standalone macro runner">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M16,4 C8,4 4,9 4,15 C4,22 9,26 16,26 L21,26">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource AccentBrush}" Thickness="3"
                                 StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M16,29 C24,29 28,24 28,18 C28,11 23,7 16,7 L12,7">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource InkBrush}" Thickness="3"
                                 StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource AccentBrush}" Geometry="M12,11 L12,3 L19,7 Z" />
                    <GeometryDrawing Brush="{StaticResource InkBrush}" Geometry="M20,22 L20,30 L13,26 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- An original relay-loop mark: two offset paths joined around a play spark. -->
            <Viewbox Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Canvas Width="36" Height="36">
                    <Path Data="M18,5 C9,5 5,10 5,17 C5,24 10,28 17,28 L22,28"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M18,31 C27,31 31,26 31,19 C31,12 26,8 19,8 L14,8"
                          Stroke="{StaticResource InkBrush}" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M14,12 L14,4 L21,8 Z" Fill="{StaticResource AccentBrush}" />
                    <Path Data="M22,24 L22,32 L15,28 Z" Fill="{StaticResource InkBrush}" />
                </Canvas>
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="RELAYLOOP RUNNER" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource MutedInkBrush}" />
                <TextBlock x:Name="MacroNameText" Text="Loading macro…" FontSize="19"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Macro name" />
            </StackPanel>

            <Border Grid.Column="2" x:Name="StatePill" CornerRadius="10"
                    Background="{StaticResource RaisedSurfaceBrush}" Padding="9,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="7" Height="7" Margin="0,0,6,0"
                             Fill="{StaticResource MutedInkBrush}" />
                    <TextBlock x:Name="StateText" Text="LOADING" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource RaisedSurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="9" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="EventCountText" Text="—" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" AutomationProperties.Name="Event count" />
                    <TextBlock Text="EVENTS" FontSize="10" Foreground="{StaticResource MutedInkBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource StrokeBrush}" Margin="0,2" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="DurationText" Text="—" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" AutomationProperties.Name="Macro duration" />
                    <TextBlock Text="DURATION" FontSize="10" Foreground="{StaticResource MutedInkBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#1AFFF0C7" BorderBrush="#66FFC768"
                BorderThickness="1" CornerRadius="8" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="M10,1 L19,18 L1,18 Z M10,6 L10,12 M10,15 L10,16"
                      Stroke="{StaticResource WarningBrush}" StrokeThickness="1.7"
                      StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"
                      VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18"
                           Foreground="#FFFFE3AD">
                    This macro controls your keyboard and mouse. Keep the emergency stop ready:
                    <Run FontWeight="Bold">Ctrl+Shift+Alt+S</Run>. Macros may violate the rules of games or services.
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="1,13,1,9">
            <CheckBox x:Name="ConfirmCheckBox"
                      Content="I understand and want to run this macro"
                      IsEnabled="False"
                      Checked="OnConfirmationChanged"
                      Unchecked="OnConfirmationChanged"
                      AutomationProperties.Name="Confirm macro playback"
                      ToolTip="Playback remains disabled until you explicitly confirm"
                      Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="DetailText" Margin="0,11,0,0" Text="Reading the embedded macro…"
                       Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="PlaybackProgress" Height="3" Margin="0,10,0,0"
                         Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource StrokeBrush}" />
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Grid.Column="0"
                    IsDefault="True" IsEnabled="False" Click="OnPlayClicked"
                    AutomationProperties.Name="Run macro"
                    ToolTip="Run once at the recorded timing">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,1 L12,7 L2,13 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Run macro" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Grid.Column="2"
                    Background="{StaticResource RaisedSurfaceBrush}"
                    Foreground="{StaticResource InkBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    IsCancel="True" IsEnabled="False" Click="OnStopClicked"
                    AutomationProperties.Name="Stop macro playback"
                    ToolTip="Stop now (Ctrl+Shift+Alt+S)">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,2 L12,2 L12,12 L2,12 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Stop" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
