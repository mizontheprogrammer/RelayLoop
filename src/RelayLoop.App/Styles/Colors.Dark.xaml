<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#FF11171B</Color>
  <Color x:Key="SurfaceColor">#FF1B2328</Color>
  <Color x:Key="SurfaceRaisedColor">#FF253036</Color>
  <Color x:Key="TextColor">#FFF4F7F8</Color>
  <Color x:Key="TextMutedColor">#FFB2C0C8</Color>
  <Color x:Key="BorderColor">#FF435159</Color>
  <Color x:Key="AccentColor">#FF58D5C9</Color>
  <Color x:Key="AccentSoftColor">#FF173D3A</Color>
  <Color x:Key="RecordColor">#FFFF7373</Color>
  <Color x:Key="RecordSoftColor">#FF4A2428</Color>
  <Color x:Key="PlayColor">#FF65D98A</Color>
  <Color x:Key="PlaySoftColor">#FF1D432A</Color>
  <Color x:Key="WarningColor">#FFFFC166</Color>
  <Color x:Key="ErrorColor">#FFFF8585</Color>
  <Color x:Key="FocusColor">#FF6AB8FF</Color>
  <Color x:Key="ScrimColor">#99000000</Color>
  <Color x:Key="ScrimTextColor">#FFFFFFFF</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}" />
  <SolidColorBrush x:Key="RecordSoftBrush" Color="{StaticResource RecordSoftColor}" />
  <SolidColorBrush x:Key="PlayBrush" Color="{StaticResource PlayColor}" />
  <SolidColorBrush x:Key="PlaySoftBrush" Color="{StaticResource PlaySoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="ScrimTextBrush" Color="{StaticResource ScrimTextColor}" />
</ResourceDictionary>
