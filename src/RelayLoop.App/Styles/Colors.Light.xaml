<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#FFF6F8FA</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceRaisedColor">#FFF0F4F7</Color>
  <Color x:Key="TextColor">#FF14212A</Color>
  <Color x:Key="TextMutedColor">#FF53636E</Color>
  <Color x:Key="BorderColor">#FFD1DADF</Color>
  <Color x:Key="AccentColor">#FF0F766E</Color>
  <Color x:Key="AccentSoftColor">#FFD7F2EE</Color>
  <Color x:Key="RecordColor">#FFC62828</Color>
  <Color x:Key="RecordSoftColor">#FFFFE2E2</Color>
  <Color x:Key="PlayColor">#FF15803D</Color>
  <Color x:Key="PlaySoftColor">#FFDCF7E5</Color>
  <Color x:Key="WarningColor">#FFB45309</Color>
  <Color x:Key="ErrorColor">#FFB91C1C</Color>
  <Color x:Key="FocusColor">#FF0B6CC4</Color>
  <Color x:Key="ScrimColor">#66000000</Color>
  <Color x:Key="ScrimTextColor">#FFFFFFFF</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="RecordBrush" Color="{StaticResource RecordColor}" />
  <SolidColorBrush x:Key="RecordSoftBrush" Color="{StaticResource RecordSoftColor}" />
  <SolidColorBrush x:Key="PlayBrush" Color="{StaticResource PlayColor}" />
  <SolidColorBrush x:Key="PlaySoftBrush" Color="{StaticResource PlaySoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="ScrimTextBrush" Color="{StaticResource ScrimTextColor}" />
</ResourceDictionary>
