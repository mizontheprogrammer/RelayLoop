<Window x:Class="RelayLoop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RelayLoop.App.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="636" Height="94" MinWidth="636" MinHeight="94" MaxHeight="760"
        WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBrush}" Topmost="{Binding AlwaysOnTop}"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        SourceInitialized="OnSourceInitialized" LocationChanged="OnLocationChanged"
        Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown"
        AutomationProperties.Name="RelayLoop macro recorder">
  <Window.Icon>
    <DrawingImage>
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="M3,7 A5,5 0 0 1 11.5,3.5">
            <GeometryDrawing.Pen>
              <Pen Brush="{DynamicResource AccentBrush}" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="{DynamicResource AccentBrush}" Geometry="M10,1 L15,2 L12,6 Z" />
          <GeometryDrawing Geometry="M13,9 A5,5 0 0 1 4.5,12.5">
            <GeometryDrawing.Pen>
              <Pen Brush="{DynamicResource PlayBrush}" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="{DynamicResource PlayBrush}" Geometry="M6,15 L1,14 L4,10 Z" />
          <GeometryDrawing Brush="{DynamicResource RecordBrush}" Geometry="M8,5 A3,3 0 1 1 7.99,5 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Icon>

  <Window.Style>
    <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}">
      <Setter Property="ResizeMode" Value="CanMinimize" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Style>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="F2" Command="{Binding RecordCommand}" />
    <KeyBinding Key="F3" Command="{Binding PlayCommand}" />
    <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleExpandedCommand}" />
    <KeyBinding Key="Delete" Modifiers="Control+Shift" Command="{Binding ClearAllEventsCommand}" />
  </Window.InputBindings>

  <Grid Background="{DynamicResource WindowBrush}" KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Compact toolbar: Open | Save | Record | Play | Stop | Export | Repeat | Speed | Settings -->
      <Border Grid.Row="0" Height="60" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="6,1" KeyboardNavigation.TabNavigation="Local">
          <Button Width="46" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding OpenCommand}"
                  Foreground="{DynamicResource AccentBrush}" ToolTip="Open macro (Ctrl+O)"
                  AutomationProperties.Name="Open macro">
            <StackPanel>
              <Path Data="{StaticResource IconOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="25" Height="25" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Open" />
            </StackPanel>
          </Button>
          <Button Width="46" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding SaveCommand}"
                  Foreground="{DynamicResource AccentBrush}" ToolTip="Save macro (Ctrl+S)"
                  AutomationProperties.Name="Save macro">
            <StackPanel>
              <Path Data="{StaticResource IconSave}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="25" Height="25" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Save" />
            </StackPanel>
          </Button>

          <Button Width="46" Command="{Binding RecordCommand}" ToolTip="Start or stop recording (F2)"
                  AutomationProperties.Name="{Binding RecordAutomationName}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ClassicToolbarButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource RecordBrush}" />
                    <Setter Property="Background" Value="{DynamicResource RecordSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecordBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel>
              <Path Data="{StaticResource IconRecord}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="23" Height="23" Stretch="Uniform" Margin="0,1" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Rec" />
            </StackPanel>
          </Button>
          <Button Width="46" Command="{Binding PlayCommand}" ToolTip="Play macro (F3)"
                  AutomationProperties.Name="{Binding PlayAutomationName}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ClassicToolbarButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PlaySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PlayBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel>
              <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="25" Height="25" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Play" />
            </StackPanel>
          </Button>
          <Button Width="46" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding PauseResumeCommand}"
                  Foreground="{DynamicResource WarningBrush}" ToolTip="Pause or resume playback"
                  AutomationProperties.Name="Pause or resume macro">
            <StackPanel>
              <Path Data="{StaticResource IconPause}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="23" Height="23" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="{Binding PauseResumeLabel}" />
            </StackPanel>
          </Button>
          <Button Width="46" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding StopCommand}"
                  Foreground="{DynamicResource RecordBrush}" ToolTip="Emergency stop (Esc or Ctrl+Shift+Alt+S)"
                  AutomationProperties.Name="Stop immediately">
            <StackPanel>
              <Path Data="{StaticResource IconStop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="22" Height="22" Stretch="Uniform" Margin="0,1.5" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Stop" />
            </StackPanel>
          </Button>
          <Button Width="46" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding ExportCommand}"
                  Foreground="{DynamicResource AccentBrush}" ToolTip="Export a standalone runner"
                  AutomationProperties.Name="Export standalone runner">
            <StackPanel>
              <Path Data="{StaticResource IconExport}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="25" Height="25" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text=".exe" />
            </StackPanel>
          </Button>

          <Border Width="62" Height="58" ToolTip="Playback repeat count, 1 to 9999">
            <StackPanel VerticalAlignment="Center">
              <Grid Height="31">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="23" />
                  <ColumnDefinition Width="35" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconRepeat}" Fill="{DynamicResource AccentBrush}"
                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Width="34" Height="24" Padding="1,0" FontSize="11"
                         Text="{Binding RepeatCount, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding ContinuousPlayback, Converter={StaticResource InverseBooleanConverter}}"
                         VerticalContentAlignment="Center" TextAlignment="Center" MaxLength="4"
                         AutomationProperties.Name="Repeat count"
                         AutomationProperties.HelpText="Enter a number from 1 to 9999" />
              </Grid>
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Repeat" />
            </StackPanel>
          </Border>

          <Border Width="68" Height="58" ToolTip="Playback speed">
            <StackPanel VerticalAlignment="Center">
              <Grid Height="31">
                <ComboBox Width="60" Height="24" Padding="1,0" FontSize="11"
                          ItemsSource="{Binding SpeedChoices}" Text="{Binding PlaybackSpeed, UpdateSourceTrigger=LostFocus}"
                          IsEditable="True" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Playback speed"
                          AutomationProperties.HelpText="Choose or type a speed multiplier" />
              </Grid>
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Speed" />
            </StackPanel>
          </Border>

          <Button Width="50" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding ToggleSettingsCommand}"
                  Foreground="{DynamicResource AccentBrush}" ToolTip="Settings"
                  AutomationProperties.Name="Open settings">
            <StackPanel>
              <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Width="25" Height="25" Stretch="Uniform" />
              <TextBlock Style="{StaticResource ClassicToolbarLabelStyle}" Text="Prefs" />
            </StackPanel>
          </Button>

          <Grid Width="96" Height="58" VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Application status"
                AutomationProperties.ItemStatus="{Binding StatusText}"
                AutomationProperties.HelpText="{Binding ElapsedText}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,1">
              <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" MaxWidth="65" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding ElapsedText}" Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Top" Margin="19,1,6,0" />
          </Grid>

          <Button Width="24" Style="{StaticResource ClassicToolbarButtonStyle}" Command="{Binding ToggleExpandedCommand}"
                  Padding="3" ToolTip="Toggle event inspector (Ctrl+E)"
                  AutomationProperties.Name="{Binding InspectorToggleAutomationName}">
            <Path Data="{StaticResource IconDown}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
              <Path.Style>
                <Style TargetType="Path">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Button>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource RecordSoftBrush}" BorderBrush="{DynamicResource RecordBrush}"
              BorderThickness="0,1,0,1" Height="64" Padding="10,6"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.LiveSetting="Assertive">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     ToolTip="{Binding ErrorMessage}" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" Margin="10,0,0,0"
                  Padding="10,3" VerticalAlignment="Center" AutomationProperties.Name="Dismiss error message" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="10,4,10,10" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.1*" MinWidth="480" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="1*" MinWidth="270" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Macro steps" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Add" Command="{Binding AddStepCommand}" Padding="8,4" Margin="0,0,4,0" />
              <Button Content="Duplicate" Command="{Binding DuplicateStepCommand}" Padding="8,4" Margin="0,0,4,0" />
              <Button Content="Up" Command="{Binding MoveStepUpCommand}" Padding="8,4" Margin="0,0,4,0" />
              <Button Content="Down" Command="{Binding MoveStepDownCommand}" Padding="8,4" Margin="0,0,4,0" />
              <Button Content="Delete step" Command="{Binding DeleteStepCommand}" Padding="8,4" Margin="0,0,8,0"
                      Foreground="{DynamicResource ErrorBrush}" />
              <Button Content="D/A Hold" Command="{Binding CreateDirectionalHoldPresetCommand}"
                      Padding="8,4" Margin="0,0,4,0"
                      ToolTip="Replace events with a repeating 2-minute D + LM1 / A + LM1 cycle at the selected or last recorded mouse position"
                      AutomationProperties.Name="Create repeating D plus LM1 and A plus LM1 two-minute cycle" />
              <Button Content="Clear all" Command="{Binding ClearAllEventsCommand}"
                      Padding="8,4" Margin="0,0,6,0" ToolTip="Clear the whole recording (Ctrl+Shift+Delete); Ctrl+Z restores it"
                      AutomationProperties.Name="Clear all recorded events" />
              <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)"
                      AutomationProperties.Name="Undo editor change">
                <Path Data="{StaticResource IconUndo}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              </Button>
              <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)"
                      AutomationProperties.Name="Redo editor change">
                <Path Data="{StaticResource IconRedo}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              </Button>
              <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding MoveEventUpCommand}" ToolTip="Move selected event earlier"
                      AutomationProperties.Name="Move selected event up">
                <Path Data="{StaticResource IconUp}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              </Button>
              <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding MoveEventDownCommand}" ToolTip="Move selected event later"
                      AutomationProperties.Name="Move selected event down">
                <Path Data="{StaticResource IconDown}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              </Button>
              <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding DeleteEventCommand}" ToolTip="Delete selected event (Delete)"
                      AutomationProperties.Name="Delete selected event">
                <Path Data="{StaticResource IconDelete}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </DockPanel>

          <TabControl Grid.Row="1">
            <TabItem Header="Steps">
              <DataGrid ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                        CanUserSortColumns="False" IsReadOnly="{Binding IsBusy}"
                        RowHeight="52"
                        AlternatingRowBackground="{DynamicResource WindowBrush}"
                        AutomationProperties.Name="Editable macro steps">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="36" />
                  <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Inputs" Width="*" MinWidth="210">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Margin="3,2">
                          <TextBlock Text="{Binding InputSummary}" Margin="2,0,2,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputSummary}" />
                          <StackPanel Orientation="Horizontal">
                          <Button Content="Record Keybind" Padding="7,2" Margin="0,0,4,0"
                                  Command="{Binding DataContext.RecordKeybindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" AutomationProperties.Name="Record keybind for this step" />
                          <Button Content="Clear" Padding="7,2"
                                  Command="{Binding DataContext.ClearKeybindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Duration" Binding="{Binding Duration, UpdateSourceTrigger=LostFocus}" Width="78" />
                  <DataGridTemplateColumn Header="Unit" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding DurationUnit, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Delay" Binding="{Binding DelayAfter, UpdateSourceTrigger=LostFocus}" Width="62" />
                  <DataGridTemplateColumn Header="Delay unit" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding DelayUnit, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="X" Binding="{Binding MouseX, UpdateSourceTrigger=LostFocus}" Width="58" />
                  <DataGridTextColumn Header="Y" Binding="{Binding MouseY, UpdateSourceTrigger=LostFocus}" Width="58" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="Recorded events">
          <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserSortColumns="False"
                    IsReadOnly="{Binding IsBusy}" AlternatingRowBackground="{DynamicResource WindowBrush}"
                    AutomationProperties.Name="Recorded macro events">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42" />
              <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="48" />
              <DataGridTextColumn Header="Event" Binding="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="118" />
              <DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="92" />
              <DataGridTextColumn Header="X" Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="72" />
              <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="72" />
              <DataGridTextColumn Header="Button" Binding="{Binding Button, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="78" />
              <DataGridTextColumn Header="Wheel" Binding="{Binding WheelDelta, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="72" />
              <DataGridCheckBoxColumn Header="H" Binding="{Binding IsHorizontalWheel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42" />
              <DataGridTextColumn Header="VK" Binding="{Binding VirtualKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="58" />
              <DataGridTextColumn Header="Scan" Binding="{Binding ScanCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="62" />
              <DataGridCheckBoxColumn Header="Ext" Binding="{Binding IsExtendedKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48" />
              <DataGridTextColumn Header="Summary" Binding="{Binding Details}" IsReadOnly="True" Width="*" MinWidth="150" />
            </DataGrid.Columns>
          </DataGrid>
            </TabItem>
          </TabControl>
        </Grid>

        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid>
            <ScrollViewer Visibility="{Binding IsSettingsOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Activity" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
              <UniformGrid Columns="2" Margin="0,0,0,8">
                <StackPanel Margin="0,0,8,8">
                  <TextBlock Text="Events" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding EventCount}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="Duration" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding MacroDurationText}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,8,8">
                  <TextBlock Text="Current loop" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding LoopText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="Remaining" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,8,8"
                            Visibility="{Binding IsDirectionalHoldPlayback, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Current hold" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding ActiveHoldText}" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8"
                            Visibility="{Binding IsDirectionalHoldPlayback, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="Time left" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding PhaseRemainingText}" FontFamily="Cascadia Mono, Consolas"
                             FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
              </UniformGrid>
              <Separator Margin="0,4,0,10" />
              <TextBlock Text="Profiles" FontWeight="SemiBold" />
              <TextBlock Text="Save the macro, playback settings, and mouse-lock choice together."
                         TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,6" />
              <ComboBox ItemsSource="{Binding Profiles}" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                        IsEditable="True" IsTextSearchEnabled="False" Margin="0,0,0,6"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        AutomationProperties.Name="Profile name or saved profile" />
              <UniformGrid Columns="3" Margin="0,0,0,7">
                <Button Content="Save" Command="{Binding SaveProfileCommand}" Padding="7,4" Margin="0,0,3,0"
                        AutomationProperties.Name="Save named profile" />
                <Button Content="Load" Command="{Binding LoadProfileCommand}" Padding="7,4" Margin="2,0"
                        AutomationProperties.Name="Load selected profile" />
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Padding="7,4" Margin="3,0,0,0"
                        Foreground="{DynamicResource ErrorBrush}"
                        AutomationProperties.Name="Delete selected profile" />
              </UniformGrid>
              <CheckBox IsChecked="{Binding LockMouseDuringDirectionalHold}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        AutomationProperties.Name="Lock mouse at the configured mouse target during playback">
                <TextBlock Text="Lock mouse at the step target during playback" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Text="{Binding MouseLockStatusText}" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="20,2,0,0" />
              <TextBlock Text="{Binding ProfileStatusText}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,0"
                         AutomationProperties.LiveSetting="Polite" />
              <Separator Margin="0,4,0,10" />
              <TextBlock Text="{Binding CurrentFileDisplay}" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DisplayLayoutStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
              <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="9" Margin="0,12,0,0">
                <TextBlock Text="Macros control your real keyboard and pointer. Review events first and use Ctrl+Shift+Alt+S if anything is unexpected. Third-party services and games may prohibit macros."
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            </ScrollViewer>

            <ScrollViewer Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Content="Done" Command="{Binding ToggleSettingsCommand}" HorizontalAlignment="Right" Padding="10,3" />
                </DockPanel>

                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" Margin="0,4,0,10"
                          AutomationProperties.Name="Application theme" />
                <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                <CheckBox Content="Three-second countdown" IsChecked="{Binding CountdownEnabled}" />
                <CheckBox Content="Play continuously until stopped" IsChecked="{Binding ContinuousPlayback}" />

                <Separator Margin="0,10" />
                <TextBlock Text="Global hotkeys" FontWeight="SemiBold" />
                <TextBlock Text="Use Ctrl, Shift, Alt and one letter. Apply checks for conflicts." Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,7" />
                <TextBlock Text="Record / stop" />
                <TextBox Text="{Binding RecordHotkeyText, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7"
                         AutomationProperties.Name="Recording global hotkey" />
                <TextBlock Text="Play" />
                <TextBox Text="{Binding PlayHotkeyText, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7"
                         AutomationProperties.Name="Playback global hotkey" />
                <TextBlock Text="Pause / resume" />
                <TextBox Text="{Binding PauseHotkeyText, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,7"
                         AutomationProperties.Name="Pause and resume global hotkey" />
                <TextBlock Text="Emergency stop" />
                <TextBox Text="{Binding StopHotkeyText, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,8"
                         AutomationProperties.Name="Emergency stop global hotkey" />
                <Button Content="Apply hotkeys" Command="{Binding ApplyHotkeysCommand}" Padding="10,6" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding HotkeyStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.RowSpan="3" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsCountingDown, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="50" AutomationProperties.LiveSetting="Assertive">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding CountdownActionText}" Foreground="{DynamicResource ScrimTextBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding CountdownValue}" Foreground="{DynamicResource ScrimTextBrush}" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Press Esc to cancel" Foreground="{DynamicResource ScrimTextBrush}" FontSize="13" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
</Window>
